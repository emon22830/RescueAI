# Database
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LLM — Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Encrypts every per-project credential connected from the Connections page — see
# app/auth/security.py. Generate one and keep it secret:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# No app's credential is configured here. Each project connects its own from its
# Connections page in the app, verified against the real API before anything is stored,
# then encrypted with the key above. Seven apps work this way — what to paste, and what
# it needs to be able to do:
#
#   Slack   Bot token (xoxb-…).
#           Read:  channels:history, groups:history, channels:read, groups:read, users:read
#           Write: chat:write — NOT needed to collect, so an older token will read fine
#                  and then fail on the first approved action. Add it and reinstall.
#           The bot must be invited to the channels it should read.
#
#   Linear  A personal API key (Settings → API → Personal API keys).
#
#   GitHub  A fine-grained token with read access to the one repository being connected,
#           plus Issues: read and write if it should open, comment on or close issues.
#
#   Jira    An API token from id.atlassian.com/manage-profile/security/api-tokens, plus
#           the site (acme.atlassian.net) and the account email the token was issued
#           for — Jira Cloud authenticates as HTTP Basic over that pair. Optionally a
#           project key (PAY), which narrows collection and is where new issues go.
#
#   Asana   A personal access token (app.asana.com/0/my-apps). The workspace is
#           discovered when the token is verified.
#
#   Trello  A user token *and* the API key it was generated against, both from
#           trello.com/power-ups/admin. The key identifies the application rather than
#           the user, so it is stored as metadata; the token is the encrypted half.
#
#   Notion  An internal integration token (notion.so/my-integrations). Notion only
#           returns pages the integration has been *shared with* — open each page →
#           ••• → Connections → add it, or the agent sees an empty workspace.

# Identifies this deployment to Google — not any one user's account. Each project
# grants its own Gmail/Drive/Calendar access from its Connections page, and that grant
# is stored encrypted per project. Create a Web application OAuth client and register
# this exact redirect URI on it:
#   http://localhost:8000/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# Where Google sends the browser back. Must match the registered redirect URI's origin.
BACKEND_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:5173

# Continuous monitoring: the in-process loop that re-analyses projects on the schedule
# each one sets from its own page (app/scheduler.py). Nothing is scheduled by default —
# a project runs only when someone turns monitoring on for it.
# Set SCHEDULER_ENABLED=false on any second instance, or two processes will both pick
# up the same due project.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
