# Database
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LLM — Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Encrypts the Slack/Linear/GitHub token each project connects for itself from the
# Connections page — see app/security.py. Generate one and keep it secret:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Slack, Linear and GitHub are no longer configured here — each project connects its
# own token from its Connections page in the app, verified live and stored encrypted.
# Scopes needed when generating those tokens:
#   Slack:  channels:history, groups:history, channels:read, groups:read, users:read
#           (invite the bot to the channels it should read)
#   Linear: a personal API key (Settings → API → Personal API keys)
#   GitHub: a fine-grained token with read access to the one repository being connected

# Identifies this deployment to Google — not any one user's account. Each project
# grants its own Gmail/Drive/Calendar access from its Connections page, and that grant
# is stored encrypted per project. Create a Web application OAuth client and register
# this exact redirect URI on it:
#   http://localhost:8000/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# Where Google sends the browser back. Must match the registered redirect URI's origin.
BACKEND_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:5173
