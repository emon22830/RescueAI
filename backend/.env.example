# Database
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Integrations — an app left blank is skipped, the others still run

# Slack bot token, scopes: channels:history, groups:history, channels:read,
# groups:read, users:read. Invite the bot to the channels it should read.
SLACK_BOT_TOKEN=
# Optional: comma-separated channel IDs to read instead of every channel the bot is in
SLACK_CHANNEL_IDS=

# Linear personal API key (Settings → API → Personal API keys)
LINEAR_API_KEY=

# GitHub fine-grained token with read access to the repo below
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# One Google OAuth client covers Gmail, Drive and Calendar. The refresh token must
# be issued for these scopes:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/drive.readonly
#   https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

CORS_ORIGINS=http://localhost:5173
