# Leave this EMPTY in dev. Empty means same-origin, so calls go through the Vite
# proxy in vite.config.ts -- no CORS, and no localhost IPv4/IPv6 mismatch.
# Set it only for a build served without the proxy, and use 127.0.0.1, not localhost.
# VITE_API_URL=

# Supabase — Project Settings → API. The anon key is meant to be public: it is
# restricted by Supabase Auth to the sign-in handshake, this frontend never queries
# the database directly with it. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
